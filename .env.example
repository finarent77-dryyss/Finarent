# ============================================================
# Finarent — Modèle de variables d'environnement
# ============================================================
#
#   cp .env.example .env
#
# Le fichier est en deux parties :
#
#   PARTIE 1 — OBLIGATOIRE AU DÉMARRAGE
#              Le minimum vital. Une fois ces valeurs renseignées,
#              `npm run dev` démarre et la page d'accueil s'affiche.
#
#   PARTIE 2 — OPTIONNEL PAR INTÉGRATION
#              Un bloc = une intégration. Sans le bloc, la fonctionnalité
#              correspondante est simplement inactive ; l'application
#              démarre quand même. Plusieurs de ces blocs sont en revanche
#              OBLIGATOIRES EN PRODUCTION — c'est signalé bloc par bloc.
#
# ⚠️  Ce fichier est VERSIONNÉ. N'y mettez jamais de valeur réelle.
#     Les secrets de production vivent dans la console Clever Cloud.
# ============================================================


# ════════════════════════════════════════════════════════════
# ════════  PARTIE 1 — OBLIGATOIRE AU DÉMARRAGE  ═════════════
# ════════════════════════════════════════════════════════════

# --- URL de l'application ---
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Base de données PostgreSQL ---
# En local : docker compose up -d db  (voir docker-compose.yml)
# Le conteneur publie le port 5433 sur l'hôte, et non 5432 : un PostgreSQL
# natif occupe déjà 5432 sur le poste de développement de référence.
# ⚠️  NE JAMAIS pointer sur la base de production depuis un poste de travail :
#     npm run dev y écrirait, et db:migrate peut proposer de l'effacer.
DATABASE_URL="postgresql://finarent:finarent@localhost:5433/finarent_dev"

# --- Auth0 (identité) ---
# Console Auth0 → Applications → Regular Web Application → Settings
# ⚠️  Le projet a deux locataires historiques (un US, un EU). Vérifier lequel
#     répond, en ouvrant /api/auth/login, avant de créer des comptes.
AUTH0_DOMAIN=votre-tenant.eu.auth0.com
AUTH0_ISSUER_BASE_URL=https://votre-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_BASE_URL=http://localhost:3000
# openssl rand -hex 32
AUTH0_SECRET=
# Connexion base de données Auth0 (email + mot de passe). Sert au lien
# « modifier mon mot de passe » depuis /espace/security.
AUTH0_DB_CONNECTION=Username-Password-Authentication

# --- Chiffrement AES-256-GCM des champs sensibles (IBAN, pièces d'identité) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# L'absence n'empêche pas le serveur de démarrer, mais toute écriture d'un
# champ chiffré échoue : profil bancaire, devis, signatures.
# ⚠️  Une fois des données chiffrées en base, cette clé ne peut plus changer
#     sans une opération de re-chiffrement : les IBAN deviendraient illisibles.
ENCRYPTION_KEY=


# ════════════════════════════════════════════════════════════
# ════════  PARTIE 2 — OPTIONNEL PAR INTÉGRATION  ════════════
# ════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════
# Propagation des rôles vers Auth0 (Management API)
# ════════════════════════════════════════════════════════════
# Application « Machine to Machine » autorisée sur la Management API,
# scopes read:users et update:users. Procédure complète : AUTH0_SETUP.md.
#
# Sans ces valeurs, changer le rôle d'un utilisateur depuis /admin/users
# n'écrit qu'en base : le claim Auth0 reprend le dessus à la connexion
# suivante et le rôle retombe silencieusement à CLIENT.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# Facultatif — uniquement avec un domaine personnalisé.
# Défaut : https://${AUTH0_DOMAIN}/api/v2/
AUTH0_M2M_AUDIENCE=


# ════════════════════════════════════════════════════════════
# Crons (Clever Cloud)          ── OBLIGATOIRE EN PRODUCTION ──
# ════════════════════════════════════════════════════════════
# Déclarés dans clevercloud/cron.json : relances clients, alertes SLA,
# purge RGPD des clics d'affiliation (13 mois, recommandation CNIL).
#
# Sans ce secret, les trois routes /api/cron/* répondent 401 et AUCUNE
# tâche ne s'exécute — le refus est volontaire (fail-closed).
# openssl rand -hex 32
CRON_SECRET=


# ════════════════════════════════════════════════════════════
# Envoi d'emails                ── OBLIGATOIRE EN PRODUCTION ──
# ════════════════════════════════════════════════════════════
# Deux canaux, dans cet ordre : l'API Brevo d'abord, SMTP en repli.
# Sans aucun des deux, aucun email transactionnel ne part — le client
# qui dépose une demande ne reçoit pas d'accusé de réception.

# --- Brevo : canal nominal (transactionnel + prospection + campagnes) ---
# Console Brevo → SMTP & API → API Keys
# Webhook à déclarer : https://VOTRE-DOMAINE/api/webhooks/brevo?token=BREVO_WEBHOOK_TOKEN
BREVO_API_KEY=
BREVO_SENDER_EMAIL=ne-pas-repondre@votre-domaine.fr
BREVO_SENDER_NAME=Finarent
BREVO_MARKETING_LIST_ID=
# openssl rand -hex 16
BREVO_WEBHOOK_TOKEN=

# --- SMTP : repli si l'API Brevo est indisponible ---
# Pour le relais Brevo : hôte smtp-relay.brevo.com, utilisateur = email du
# compte Brevo, mot de passe = clé SMTP (préfixe xsmtpsib, PAS la clé API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@votre-domaine.fr

# --- Destinataire des alertes internes (nouvelle demande, incident) ---
ADMIN_EMAIL=

# --- Signature des liens de désinscription ---
# Optionnel : à défaut, ENCRYPTION_KEY puis CRON_SECRET servent de repli.
UNSUBSCRIBE_SECRET=


# ════════════════════════════════════════════════════════════
# Stockage des documents (KYC)  ── OBLIGATOIRE EN PRODUCTION ──
# ════════════════════════════════════════════════════════════
# Clever Cloud Cellar (S3). L'addon injecte automatiquement CELLAR_ADDON_*
# en production ; le bucket doit être créé au préalable.
#
# ⚠️  Sans ces valeurs, le stockage retombe sur private/uploads/, c'est-à-dire
#     le disque de l'instance : les documents sont PERDUS à chaque
#     redéploiement. Ce mode est réservé au développement local.
CELLAR_ADDON_HOST=cellar-c2.services.clever-cloud.com
CELLAR_ADDON_KEY_ID=
CELLAR_ADDON_KEY_SECRET=
CELLAR_BUCKET=finarent-docs-kyc
CELLAR_REGION=us-east-1


# ════════════════════════════════════════════════════════════
# Protection des formulaires publics
# ════════════════════════════════════════════════════════════
# reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# Déclarer les domaines de production ET localhost.
# ⚠️  NEXT_PUBLIC_* est figée au moment du build : la définir AVANT de déployer.
# ⚠️  Renseigner les DEUX ou AUCUNE : la clé publique seule affiche le widget
#     sans que la vérification serveur puisse aboutir.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=


# ════════════════════════════════════════════════════════════
# Paiement des factures
# ════════════════════════════════════════════════════════════
# Stripe → Developers → API keys, puis Webhooks :
#   URL       : https://VOTRE-DOMAINE/api/webhooks/stripe
#   Événement : checkout.session.completed
# Commencer en mode Test (sk_test_) avant de basculer en Live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ════════════════════════════════════════════════════════════
# Signature électronique
# ════════════════════════════════════════════════════════════
# Sans clé, la signature retombe sur le mode interne (case à cocher +
# preuve horodatée en base), sans valeur eIDAS.
YOUSIGN_API_KEY=
YOUSIGN_BASE_URL=https://api.yousign.com


# ════════════════════════════════════════════════════════════
# Téléphonie du centre d'appels
# ════════════════════════════════════════════════════════════
# Ringover → clé API avec Calls Write + Monitoring activés.
# Webhook : https://VOTRE-DOMAINE/api/webhooks/ringover
#   Événements : hangup, missed calls, voicemail, contact search
#   L'en-tête Authorization porte la clé BRUTE, sans préfixe « Bearer ».
# L'email de chaque agent Ringover doit correspondre exactement à celui
# de son compte Finarent, sinon la correspondance échoue.
RINGOVER_API_KEY=
RINGOVER_WEBHOOK_KEY=
RINGOVER_SMS_FROM_NUMBER=+33XXXXXXXXX


# ════════════════════════════════════════════════════════════
# SMS de secours
# ════════════════════════════════════════════════════════════
# Lues par lib/sms.js : les trois ensemble activent Twilio, sinon les SMS
# sont seulement journalisés en console. Le canal nominal reste Ringover.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ════════════════════════════════════════════════════════════
# Observabilité
# ════════════════════════════════════════════════════════════
# Sans DSN Sentry, aucune erreur de production ne remonte : les incidents
# ne sont connus que lorsqu'un utilisateur téléphone.
# ⚠️  Variables NEXT_PUBLIC_* : figées au build, à définir AVANT de déployer.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=


# ════════════════════════════════════════════════════════════
# Scripts de développement — inutile pour faire tourner l'application
# ════════════════════════════════════════════════════════════
# scripts/seed-demo.js crée quatre comptes @demo.fr rattachés à des
# identifiants Auth0. Ces identifiants n'ont de sens que sur le locataire
# qui les a émis : si AUTH0_DOMAIN en désigne un autre, recréez les comptes
# et reportez leurs user_id ici, sinon ils ne pourront pas se connecter.
# AUTH0_DEMO_ADMIN_ID="auth0|..."
# AUTH0_DEMO_CLIENT_ID="auth0|..."
# AUTH0_DEMO_PARTNER_ID="auth0|..."
# AUTH0_DEMO_INSURER_ID="auth0|..."
#
# scripts/test-ringover-webhook.js envoie un webhook Ringover simulé.
# À défaut, http://localhost:3000.
# WEBHOOK_BASE=http://localhost:3000


# ════════════════════════════════════════════════════════════
# Variables fournies par la plateforme — ne pas définir en local
# ════════════════════════════════════════════════════════════
# POSTGRESQL_ADDON_URI   injectée par l'addon Clever Cloud, recopiée dans
#                        DATABASE_URL par scripts/build.js et scripts/start.js
# PORT / HOSTNAME        fournies par l'hébergeur au démarrage
# NODE_ENV               « production » sur l'environnement déployé
#
# Configuration Clever Cloud à déclarer dans la console (pas ici) :
#   CC_BUILD_COMMAND     npm run build:standalone
#   CC_RUN_COMMAND       npm run start:standalone
#   CC_HEALTH_CHECK_PATH /api/health
