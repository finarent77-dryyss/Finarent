# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.next
dist
dist-ssr
*.local

# Environment variables (secrets)
.env
.env.*
!.env.example

# Claude Code — paramètres locaux (peuvent contenir des commandes avec secrets)
.claude/

# Documentation client locale (PDFs, sources logos, briefs) — hors git
docs/client/

# Livraison client : HTML generes par scripts/build-livraison.mjs.
# Derivables des .md a tout moment — hors dépôt pour ne pas versionner 1 Mo
# de sortie regeneree a chaque modification de la documentation.
docs/livraison-client/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

/app/generated/prisma
prisma/dev.db
prisma/*.db

# Archives et fichiers système
templates.rar
nul

# Documents uploadés (données sensibles — jamais commités)
private/uploads/

# Double SQLite résiduel
prisma/prisma/
test-e2e-report.json

.vercel
# Vidages memoire produits par les outils POSIX sous Windows.
*.stackdump

# Aperçus de mailing générés localement (scripts/preview-emails.mjs)
.email-preview/

# Cache incremental de TypeScript : artefact de build, regenere a chaque
# `tsc`. Suivi par git jusqu'ici, il salissait chaque commit sans rien
# apporter — deux developpeurs ne produisent jamais le meme.
tsconfig.tsbuildinfo
